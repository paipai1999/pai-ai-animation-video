# Google Gemini API Key (Required for Video Multimodal Vision Analysis & Storyboard)
GEMINI_API_KEY=your_gemini_api_key_here

# Redis Broker URL (For Celery async workers)
REDIS_URL=redis://localhost:6379/0

# Database URL (SQLite default, or PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/db)
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db

# Cloudflare R2 / AWS S3 Storage (Optional - Falls back to local disk storage if empty)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
